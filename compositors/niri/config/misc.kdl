prefer-no-csd

window-rule {
    match is-active=true
    geometry-corner-radius 10
    clip-to-geometry true

    opacity 0.75
    draw-border-with-background false

    background-effect {
        xray false
        blur true
        noise 0.05
    }
    popups {
        opacity 0.9
        geometry-corner-radius 10
    }
    
}

window-rule {
    match title="Firefox"
    opacity 1.0
}

window-rule {
    match app-id="Nautilus"
    opacity 0.90
}

window-rule {
    match app-id="Sober"
    opacity 1.0
}

blur {
    // off
    passes 2
    offset 1
    noise 0.5
    saturation 1.5
}
